{
  "name": "dentpilot-frontend",
  "private": true,
  "version": "1.31.2",
  "type": "module",
  "description": "React-клиент DentPilot 2.0 поверх существующего Python/FastAPI движка",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "dev:dental3d": "vite --open /prototypes/dental3d/index.html",
    "typecheck:dental3d": "tsc -p prototypes/tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "three": "^0.180.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
