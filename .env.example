# Серверный запуск (docker compose): скопировать в .env (он в .gitignore) и
# НИКОГДА не коммитить.
# Ключ входа в журнал — длинная случайная строка. Обязателен: без него compose
# не стартует (первичная установка PIN отвечает только браузеру на той же
# машине, а запрос в контейнер приходит из сети Docker).
ADMIN_KEY=
