# DentPilot Cloud — окружение сервера. Скопировать в cloud.env рядом (он в .gitignore),
# заполнить, chmod 600. ⛔ Ни одно значение отсюда не попадает в репозиторий, образ или письмо.
# Пустая переменная означает «нет», а не умолчание; `python -m app.tools check` скажет, чего не хватает.
# ⚠ Комментарий только отдельной строкой: env_file у compose и EnvironmentFile у systemd
#   не срезают «# …» после значения — он стал бы частью значения.

# --- база и ключ: пути ВНУТРИ контейнера, тома — в docker-compose.yml ---
DP_CLOUD_DB=/srv/data/cloud.db
# приватный ключ выдачи: python -m app.tools keygen --kid 2026a --out /srv/keys/2026a.pem
DP_LICENSE_KEY=/srv/keys/2026a.pem
# kid для PEM-ключа (у тестового .json kid лежит внутри файла)
DP_LICENSE_KID=2026a

# --- администратор ---
DP_ADMIN_USER=oleg
# python -m app.tools hash-password
DP_ADMIN_HASH=
# подпись куки сессии: openssl rand -hex 32; пусто = всех разлогинит при рестарте
DP_SECRET=
# 1 за TLS (Caddy); 0 только для localhost без https
DP_SECURE_COOKIES=1
DP_BASE_URL=https://cloud.dentpilot.md

# --- почта: SMTP с STARTTLS; без хоста письма ложатся файлами в DP_MAIL_OUTBOX ---
DP_SMTP_HOST=smtp.gmail.com
DP_SMTP_PORT=587
DP_SMTP_USER=dentpilotpro@gmail.com
# пароль приложения Google, не пароль ящика
DP_SMTP_PASS=
DP_MAIL_FROM=dentpilotpro@gmail.com
# только для сухого прогона (тесты, разбор): папка, куда ложатся .eml
DP_MAIL_OUTBOX=

# --- реквизиты в письмах о переводе; пусто = письмо честно говорит «nota o primiți separat» ---
DP_BANK_BENEFICIARY=
DP_BANK_IBAN=
DP_BANK_NAME=
DP_BANK_CODE=
# адрес продавца на cont de plată (PDF после оплаты); имя, IDNO и IBAN — те же DP_BANK_*
DP_SELLER_ADDRESS=

# --- прайс абонемента, лей за месяц (год = 11 месяцев): DentPilot Basic без модуля SMS, Plus — с ним ---
# --- ⛔ цены только здесь, не в репозитории; пусто = вариант не продаётся, страница оплаты его не предлагает ---
DP_PRICE_BASIC=
DP_PRICE_PLUS=

# --- оплата картой через maib e-Commerce Checkout (L12, API v2); три ключа от банка, пусто = только переводом ---
# адрес API без пути: боевой https://api.maibmerchants.md, песочница https://sandbox.maibmerchants.md
# (у песочницы свои ключи; адрес и ключи меняются вместе)
DP_MAIB_BASE_URL=https://api.maibmerchants.md
DP_MAIB_CLIENT_ID=
DP_MAIB_CLIENT_SECRET=
# ключ подписи callback (Signature Key проекта)
DP_MAIB_SIGNATURE_KEY=

# --- заявка на пробный (/proba и из программы): auto = файл сразу, программа включается в момент заявки ---
# --- (решение 26.09); approve = заявка ждёт кнопки «Выдать» в админке ---
DP_TRIAL_MODE=auto
# куда письмо о каждой заявке; пусто = ящик поддержки из config.py
DP_TRIAL_NOTIFY=

# --- декларация поставщика (Legea 195): подписанный PDF, путь ВНУТРИ контейнера; ---
# --- на машине — /srv/dentpilot/data/declaratie-195.pdf; пусто = письма с файлом без неё ---
DP_DECLARATION=/srv/data/declaratie-195.pdf
# --- договор лицензии и соглашение об обработке данных (29.10): PDF, подписанные Олегом один раз на ---
# --- версию; клиника скачивает их в кабинете. Дата в имени файла = версия документа; пусто = «ещё не выложен» ---
DP_CONTRACT=/srv/data/contract-licenta-2026-10-29.pdf
DP_DPA=/srv/data/acord-prelucrare-2026-10-29.pdf

# --- кабинет клиники (/cont): вход через Google — OAuth-клиент «Web application» из консоли ---
# --- Google Cloud, redirect URI = https://cloud.dentpilot.md/auth/google/callback (DEPLOY.md § 3); ---
# --- оба пусты = кабинет закрыт, страница говорит об этом словами ---
DP_GOOGLE_CLIENT_ID=
DP_GOOGLE_CLIENT_SECRET=
# адреса Google OpenID Connect; менять только для стенда
DP_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
DP_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# --- скачивание с сайта (/descarca): API последнего выпуска GitHub; менять только для стенда ---
DP_RELEASES_API=https://api.github.com/repos/olegbacalu-maker/dental-booking-bot/releases/latest

# --- сервер обновлений (/v1/update): выпуск по тегу и атом-фид для канала beta; менять только для стенда ---
DP_RELEASES_TAG_API=https://api.github.com/repos/olegbacalu-maker/dental-booking-bot/releases/tags/{tag}
DP_RELEASES_ATOM=https://github.com/olegbacalu-maker/dental-booking-bot/releases.atom
# как часто сервер спрашивает GitHub о свежем выпуске канала, секунд
DP_UPDATE_CACHE_S=300

# --- SMS-пакет (docs/dentpilot-2/sms.md): токен sms.md живёт только здесь, на VPS ---
# токен из кабинета sms.md (Settings → API) с правами messages:send, messages:read,
# account:read, senders:read; пусто = SMS выключены, программа получает 503 sms_unconfigured
DP_SMSMD_TOKEN=
# адрес API sms.md; менять только для стенда
DP_SMSMD_BASE_URL=https://api.sms.md/v3
# секрет адреса уведомлений о доставке: в кабинете sms.md DLR URL = https://cloud.dentpilot.md/v1/smsmd/dlr/<секрет>
# (openssl rand -hex 16); пусто = уведомлений нет, статусы собирает опрос
DP_SMSMD_DLR_SECRET=
# тихие часы по Кишинёву «с-до»; менять только для стенда
DP_SMS_QUIET=21-8
# показ пакета программам: пусто = только клиникам с отметкой «пилот» в карточке (токен при этом уже
# может стоять — для SMS себе); 1 = всем клиникам (после 30 дней уведомления, S7)
DP_SMS_OFFERED=
# пополнения SMS «штук:лей» через запятую (решение 16.10: 100, 200, 300, 400, 500 — дешевле с объёмом);
# цены только здесь, не в репозитории; пусто = пополнений нет, программа получает sms_no_packs
DP_SMS_PACKS=
# своё имя отправителя — лей за год; пусто = имя не продаётся (sms_no_name), SMS идут от DentPilot
DP_SMS_NAME_PRICE=
