# Caddy перед сервером лицензий: TLS от Let's Encrypt сам, http → https сам.
# Домен — тот же, что DP_BASE_URL. Upstream `cloud:8090` — имя службы в
# docker-compose.yml; без Docker (systemd) — 127.0.0.1:8090.
cloud.dentpilot.md {
	encode gzip
	# формы админки и /proba — килобайты; поток гигабайт в публичную форму — нет
	request_body {
		max_size 256KB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# ⛔ Не no-referrer: при этой политике браузер ставит в POST обычной формы
		# Origin: null (Fetch, «append a request Origin header»), и проверка
		# same_origin_post отвечает 403 на каждую форму — вход, регистрацию,
		# заявку. fetch() этого не делает, поэтому тесты без Caddy зелёные
		# (01.10, первый живой вход Олега). strict-origin-when-cross-origin —
		# полный Referer внутри сайта, только origin наружу.
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy cloud:8090
}
