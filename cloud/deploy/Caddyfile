# Caddy перед сервером лицензий: TLS от Let's Encrypt сам, http → https сам.
# Домен — тот же, что DP_BASE_URL. Upstream `cloud:8090` — имя службы в
# docker-compose.yml; без Docker (systemd) — 127.0.0.1:8090.
cloud.dentpilot.md {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# ⛔ Не no-referrer: при этой политике браузер ставит в POST обычной формы
		# Origin: null (Fetch, «append a request Origin header»), и проверка
		# same_origin_post отвечает 403 на каждую форму — вход, регистрацию,
		# заявку. fetch() этого не делает, поэтому тесты без Caddy зелёные
		# (01.10, первый живой вход Олега). strict-origin-when-cross-origin —
		# полный Referer внутри сайта, только origin наружу.
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Загрузки подписанных PDF читает само приложение и на слишком большой файл
	# отвечает страницей кабинета; предел ниже его потолка чтения отдал бы
	# клинике голый 413 вместо этих слов. MiB, не MB: MB здесь десятичные.
	@upload path /cont/sms/cerere /cont/documente/incarca
	handle @upload {
		request_body {
			max_size 32MiB
		}
		reverse_proxy cloud:8090
	}
	# формы админки и /proba — килобайты; поток гигабайт в публичную форму — нет
	handle {
		request_body {
			max_size 256KB
		}
		reverse_proxy cloud:8090
	}
}

# Короткий адрес ответа пациента из SMS (Premium, plink_page.py): v.dentpilot.md/K7Q2MX. DNS A — тот же сервер,
# «DNS only». Здесь только страница кода (переписывается на /r/<код> приложения, ?l= сохраняется) и картинка
# карточки превью; всё прочее — 404: кабинет, админка и API живут только на cloud.dentpilot.md.
v.dentpilot.md {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# ⛔ Не no-referrer: кнопки «Vin» / «Nu pot veni» — обычная форма POST, при no-referrer браузер шлёт
		# Origin: null, и same_origin_post отвечает 403 (тот же прайор, что у cloud.dentpilot.md выше)
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@code path_regexp code ^/([A-Za-z0-9]{6})$
	handle @code {
		request_body {
			max_size 8KB
		}
		rewrite * /r/{re.code.1}
		reverse_proxy cloud:8090
	}
	handle /og/confirm.png {
		reverse_proxy cloud:8090
	}
	handle {
		respond 404
	}
}
