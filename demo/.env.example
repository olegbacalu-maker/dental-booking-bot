# Скопировать в .env рядом (он в .gitignore). Токен туннеля Cloudflare —
# Zero Trust › Networks › Tunnels › <туннель> › Install connector (Docker):
# строка после `--token`. Вписывает владелец, в репозиторий не едет.
TUNNEL_TOKEN=
# Сколько копий и на сколько минут (по умолчанию 6 × 60)
DEMO_SLOTS=6
DEMO_TTL_MIN=60
